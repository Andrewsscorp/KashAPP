<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 1. Servicio lector de notificaciones bancarias (protegido por permiso de firma del SO) -->
        <service
            android:name=".service.BankNotificationListenerService"
            android:label="KashApp Captura Bancaria Automática"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 2. BroadcastReceiver interno para los botones [Confirmar] e [Ignorar] -->
        <receiver
            android:name=".service.AutoCaptureActionReceiver"
            android:exported="false" />

        <!-- 3. Quick Settings Tile para gasto rápido en efectivo desde la barra de estado -->
        <service
            android:name=".service.QuickCashTileService"
            android:label="Gasto Efectivo"
            android:icon="@android:drawable/ic_input_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
